{
  "license": "GPL-3.0-only",
  "name": "nowluma-monorepo",
  "version": "2.5.0-rc.2",
  "description": "Nowluma monorepo workspace (pnpm)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @nowluma/core build",
    "build:sdk": "pnpm --filter @nowluma/sdk build",
    "build:webui": "pnpm --filter webui build",
    "build:mcp": "pnpm --filter @nowluma/mcp build",
    "build:all": "pnpm --filter @nowluma/core build:all && pnpm --filter @nowluma/sdk build && pnpm --filter @nowluma/mcp build && pnpm --filter @nowluma/ui build && pnpm --filter webui build",
    "check:release-layout": "node tools/check-release-layout.mjs",
    "dev": "pnpm --filter @nowluma/core dev",
    "dev:mode": "cd dist && cross-env NOWLUMA_DEV_MODE=1 NOWLUMA_DEV_WEBUI=1 node index.mjs",
    "dev:web": "pnpm --filter webui dev",
    "docs:dev": "node tools/dev-docs.mjs",
    "docs:build": "node tools/build-docs.mjs",
    "docs:build:all": "pnpm docs:build && pnpm --filter webui exec vite build --config vite.demo.config.ts && node tools/check-docs.mjs --with-demo",
    "docs:preview": "vitepress preview docs",
    "test": "pnpm test:workflows && pnpm test:tools && pnpm --filter=\"./packages/**\" -r --no-bail --if-present test",
    "test:workflows": "node --test .github/scripts/*.test.cjs",
    "test:tools": "node --test \"tools/*.test.mjs\"",
    "test:core": "pnpm --filter @nowluma/core test",
    "test:watch": "pnpm --filter @nowluma/core test:watch",
    "test:common": "pnpm --filter @nowluma/common test",
    "test:all": "pnpm test",
    "test:native": "pnpm --filter=\"./packages/**\" -r --if-present test:native",
    "coverage": "node tools/coverage.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint --config eslint.format.config.ts --fix \"**/*.{ts,tsx,mts,cts}\" && prettier --write \"**/*.{ts,tsx,mts,cts}\"",
    "format:check": "eslint --config eslint.format.config.ts \"**/*.{ts,tsx,mts,cts}\" && prettier --check \"**/*.{ts,tsx,mts,cts}\"",
    "ci": "node tools/ci-check.mjs",
    "start": "node dist/index.mjs",
    "bump": "node tools/bump-version.mjs",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.58.2",
    "vitepress": "1.6.4",
    "vue": "3.5.45"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.22.1 || >=26.12.1",
    "pnpm": "11.25.0"
  }
}
