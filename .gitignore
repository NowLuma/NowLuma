# Ignore files generated by Claude
.claude

# Node / pnpm / monorepo
node_modules/
**/node_modules/
dist/
**/dist/
/_site/
.vscode/
.idea/

/config/
/data/
# per-package runtime data dirs (e.g. packages/core/data/<uin>/*.db written by
# IdentityService during tests) — not just the root /data/
**/data/
logs/

# macOS metadata
.DS_Store

# test coverage output
coverage/

# local reverse-engineering workspace and upstream reference clones
/_re/
/_refs/

# deployment scratch produced by deploy/install.sh
/deploy/nowluma/
/deploy/.env

# Windows executable build inputs/outputs
/deploy/windows/bin/
/deploy/windows/obj/
/deploy/windows/payload.zip
/deploy/windows/PayloadInfo.g.cs
